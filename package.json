{
  "name": "cv-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Chessveda analysis microservice \u2014 server-side Stockfish evaluation with WintrChess-derived move classification.",
  "keywords": [
    "chess",
    "stockfish",
    "analysis",
    "uci",
    "move-classification"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Midas 24x7 Games Private Limited",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "NODE_ENV=development nodemon --exec \"node -r esbuild-register -r tsconfig-paths/register ./src/index.ts\" -e ts,json",
    "build": "tsc && tsc-alias && node -e \"require('fs').cpSync('src/resources','dist/resources',{recursive:true,filter:(s)=>!s.endsWith('.ts')})\"",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.17.21",
    "morgan": "^1.11.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.12.12",
    "esbuild": "^0.23.0",
    "esbuild-register": "^3.5.0",
    "nodemon": "^3.1.4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
