# Template for both .env.development and .env.production.
#
#   npm run dev    -> NODE_ENV=development -> reads .env.development
#   npm start      -> NODE_ENV=production  -> reads .env.production
#
# NODE_ENV is set by the npm script, not by this file: it decides which file
# gets read, so it has to be set before the file is loaded. Anything already
# in the environment (a container's --env-file, systemd Environment=) wins
# over these values.

# HTTP
PORT=8090

# Shared secret the Chessveda backend sends as `x-analysis-key`. Leave blank to
# disable auth (local development only — never in a deployed environment).
ANALYSIS_SERVICE_KEY=

# Comma-separated origins allowed to call this service directly. The normal
# deployment has only the Chessveda backend calling it, so this stays empty.
CORS_ORIGINS=

# Path to the Stockfish binary.
#   macOS  : brew install stockfish
#            -> /opt/homebrew/bin/stockfish  (Apple Silicon)
#            -> /usr/local/bin/stockfish     (Intel)
#   Ubuntu : apt-get install stockfish
#            -> /usr/games/stockfish
#            NOTE: /usr/games is often absent from the PATH a systemd service
#            runs with, so give the absolute path rather than bare "stockfish".
STOCKFISH_PATH=stockfish

# Search limits
DEFAULT_DEPTH=16
MAX_DEPTH=25
# Hard wall-clock cap for a single position search, in milliseconds.
MOVETIME_MS=3000
# Threads passed to Stockfish per engine instance.
ENGINE_THREADS=1
# Hash table size in MB, per engine instance.
ENGINE_HASH_MB=64

# Concurrency
# How many whole-game reviews may run at the same time.
MAX_CONCURRENT_REVIEWS=2
# How many individual engine searches may run at the same instant, across all
# reviews. Keep at or below the core count of the host.
MAX_CONCURRENT_SEARCHES=2
# Longest a single game review may take before it is abandoned, in ms.
REVIEW_TIMEOUT_MS=600000
# Most half-moves a single review request may contain.
MAX_MOVES=400
